engine = create_engine("sqlite:///postman_zone.db", connect_args={"check_same_thread": False})


@event.listens_for(engine, "connect")
def enable_foreign_keys(dbapi_connection, _record):
    cursor = dbapi_connection.cursor()
    cursor.execute("PRAGMA foreign_keys=ON")
    cursor.close()


SessionLocal = sessionmaker(bind=engine, autoflush=False, expire_on_commit=False)


def local_db():
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()


def stand_in_role_check(*roles):
    # CHANGED: reads the X-Test-User header, which is what the frontend and Postman send
    def checker(x_test_user: str | None = Header(default=None), db: Session = Depends(local_db)):
        if x_test_user is None:
            raise HTTPException(status_code=401, detail="Not authenticated")
        try:
            user = db.get(User, uuid.UUID(x_test_user))
        except ValueError:
            user = None
        if user is None or not user.is_active:
            raise HTTPException(status_code=401, detail="Invalid or expired token")
        if user.role not in roles:
            raise HTTPException(status_code=403, detail="You do not have permission to do this.")
        return user

    return checker


coordinator_only = stand_in_role_check(UserRole.PATROL_COORDINATOR)
any_user = stand_in_role_check(UserRole.PATROL_COORDINATOR, UserRole.PATROL_OFFICER)

for name, checker in [
    ("require_coordinator", coordinator_only),
    ("require_any_user", any_user),
]:
    if not hasattr(security, name):
        setattr(security, name, checker)

